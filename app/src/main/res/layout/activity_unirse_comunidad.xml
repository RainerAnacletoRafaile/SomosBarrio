<?xml version="1.0" encoding="utf-8"?>
<!-- EXTRA (del diagrama de flujo): VECINO - Unirme a una comunidad.
     Revisa los textos contra tu diseño original, la captura del diagrama es pequeña. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_app"
    tools:context=".UnirseComunidadActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <include
            layout="@layout/include_logo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

            <TextView
                style="@style/SbTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/sb_unirme_titulo" />

            <TextView
                style="@style/SbSubtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/sb_unirse_subtitulo" />

            <!-- Código de invitación -->
            <LinearLayout
                style="@style/SbInputBox"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp">

                <ImageView
                    style="@style/SbInputIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_key" />

                <EditText
                    android:id="@+id/etCodigoInvitacion"
                    style="@style/SbEditText"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="@string/sb_hint_codigo"
                    android:importantForAutofill="no"
                    android:inputType="textCapCharacters"
                    android:maxLength="10" />
            </LinearLayout>

            <!-- Permiso de ubicación -->
            <LinearLayout
                style="@style/SbInfoBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_location"
                    android:tint="@color/sb_azul" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sb_permiso_ubicacion_titulo"
                        android:textColor="@color/sb_azul_oscuro"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/SbInfoTexto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/sb_permiso_ubicacion_desc" />
                </LinearLayout>
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSolicitarIngreso"
                style="@style/SbBtnPrimario"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:text="@string/sb_solicitar_ingreso" />

            <ImageView
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:src="@drawable/sb_ilustracion_unirse" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnVolver"
                style="@style/SbBtnContorno"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:drawableStart="@drawable/ic_arrow_back"
                android:text="@string/sb_volver" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
