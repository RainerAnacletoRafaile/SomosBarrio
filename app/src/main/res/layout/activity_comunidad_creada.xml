<?xml version="1.0" encoding="utf-8"?>
<!-- MÓDULO 5: COMUNIDAD CREADA -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_app"
    tools:context=".ComunidadCreadaActivity">

    <ImageView
        android:id="@+id/ivFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:scaleType="fitEnd"
        android:src="@drawable/sb_ilustracion_barrio" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="150dp">

            <include
            layout="@layout/include_logo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginTop="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_check_circle" />

            <TextView
                style="@style/SbTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/sb_comunidad_creada" />

            <TextView
                style="@style/SbSubtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/sb_ahora_presidente" />

            <!-- Tarjeta de la comunidad (datos de ejemplo con tools:text; se llenan desde Java) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_comunidad"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sb_ilustracion_casa_card" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="90dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="12dp"
                    android:background="@color/sb_azul_borde" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNombreComunidadCreada"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/sb_azul_oscuro"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        tools:text="Urb. Los Jazmines" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_location"
                            android:tint="@color/sb_azul" />

                        <TextView
                            android:id="@+id/tvUbicacionComunidadCreada"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:textColor="@color/sb_texto"
                            android:textSize="14sp"
                            tools:text="San Martín de Porres, Lima" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDescripcionComunidad"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/sb_texto"
                        android:textSize="14sp"
                        tools:text="Comunidad vecinal para una convivencia segura y organizada." />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/SbTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/sb_tu_codigo"
                android:textSize="22sp" />

            <TextView
                style="@style/SbSubtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/sb_codigo_subtitulo"
                android:textSize="15sp" />

            <!-- Código + botón copiar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCodigoInvitacion"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_codigo"
                    android:gravity="center"
                    android:letterSpacing="0.05"
                    android:textColor="@color/sb_azul_oscuro"
                    android:textIsSelectable="true"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    tools:text="JAZM347" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnCopiarCodigo"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:stateListAnimator="@null"
                    android:textAllCaps="false"
                    android:layout_width="wrap_content"
                    android:layout_height="64dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_btn_copiar"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_copy"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/sb_azul"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="@string/sb_copiar"
                    android:textColor="@color/sb_azul"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                style="@style/SbInfoBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_info"
                    android:tint="@color/sb_azul" />

                <TextView
                    style="@style/SbInfoTexto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/sb_info_codigo" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnIrMiComunidad"
                style="@style/SbBtnPrimario"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:drawableStart="@drawable/ic_home"
                android:text="@string/sb_ir_mi_comunidad" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
