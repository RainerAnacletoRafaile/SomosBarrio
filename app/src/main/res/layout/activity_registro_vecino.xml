<?xml version="1.0" encoding="utf-8"?>
<!-- MÓDULO 2: REGISTRO DE VECINO (Crear cuenta) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_app"
    tools:context=".RegistroActivity">

    <ImageView
        android:id="@+id/ivFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:scaleType="fitEnd"
        android:src="@drawable/sb_ilustracion_barrio" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="150dp">

            <include
            layout="@layout/include_logo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

            <TextView
                style="@style/SbTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/sb_crear_cuenta" />

            <TextView
                style="@style/SbSubtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/sb_registro_subtitulo" />

            <!-- Nombres -->
            <LinearLayout
                style="@style/SbInputBox"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp">

                <ImageView
                    style="@style/SbInputIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_person" />

                <EditText
                    android:id="@+id/etNombres"
                    style="@style/SbEditText"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="@string/sb_hint_nombres"
                    android:importantForAutofill="no"
                    android:inputType="textPersonName|textCapWords" />
            </LinearLayout>

            <!-- Apellidos -->
            <LinearLayout
                style="@style/SbInputBox"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp">

                <ImageView
                    style="@style/SbInputIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_person" />

                <EditText
                    android:id="@+id/etApellidos"
                    style="@style/SbEditText"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="@string/sb_hint_apellidos"
                    android:importantForAutofill="no"
                    android:inputType="textPersonName|textCapWords" />
            </LinearLayout>

            <!-- Celular -->
            <LinearLayout
                style="@style/SbInputBox"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp">

                <ImageView
                    style="@style/SbInputIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_phone" />

                <EditText
                    android:id="@+id/etTelefonoRegistro"
                    style="@style/SbEditText"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="@string/sb_hint_celular"
                    android:importantForAutofill="no"
                    android:inputType="phone"
                    android:maxLength="9" />
            </LinearLayout>

            <!-- Contraseña -->
            <LinearLayout
                style="@style/SbInputBox"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp">

                <ImageView
                    style="@style/SbInputIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_lock" />

                <EditText
                    android:id="@+id/etPasswordRegistro"
                    style="@style/SbEditText"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="@string/sb_hint_password"
                    android:importantForAutofill="no"
                    android:inputType="textPassword" />

                <ImageView
                    android:id="@+id/ivTogglePassword"
                    style="@style/SbInputIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/sb_mostrar_password"
                    android:src="@drawable/ic_visibility" />
            </LinearLayout>

            <!-- Aviso de ubicación -->
            <LinearLayout
                style="@style/SbInfoBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_location"
                    android:tint="@color/sb_azul" />

                <TextView
                    style="@style/SbInfoTexto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/sb_info_ubicacion" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCrearCuenta"
                style="@style/SbBtnPrimario"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:drawableStart="@drawable/ic_person_add"
                android:text="@string/sb_crear_cuenta" />

            <include layout="@layout/include_divisor_o" />

            <TextView
                android:id="@+id/tvIrLogin"
                style="@style/SbBtnContorno"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:text="@string/sb_ya_tienes_cuenta"
                android:textSize="16sp"
                android:textStyle="normal" />

        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/tvVolverRegistro"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/sb_volver_desc"
        android:drawableStart="@drawable/ic_arrow_back"
        android:drawableTint="@color/sb_azul"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp" />
</FrameLayout>
