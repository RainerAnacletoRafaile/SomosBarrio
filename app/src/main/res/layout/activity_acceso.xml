<?xml version="1.0" encoding="utf-8"?>
<!-- MÓDULO 3: ACCESO (¿Qué deseas hacer?) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_app"
    tools:context=".AccesoActivity">

    <ImageView
        android:id="@+id/ivFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:scaleType="fitEnd"
        android:src="@drawable/sb_ilustracion_barrio" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="150dp">

            <include
            layout="@layout/include_logo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

            <TextView
                style="@style/SbTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/sb_que_deseas" />

            <TextView
                style="@style/SbSubtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/sb_acceso_subtitulo" />

            <!-- Opción: Crear una comunidad (presidente) -->
            <LinearLayout
                android:id="@+id/cardCrearComunidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:background="@drawable/bg_card_crear"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="150dp"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="105dp"
                    android:layout_height="105dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sb_ilustracion_crear" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="100dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="12dp"
                    android:background="@color/sb_azul_borde" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sb_crear_comunidad_titulo"
                        android:textColor="@color/sb_azul_oscuro"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/sb_crear_comunidad_desc"
                        android:textColor="@color/sb_texto"
                        android:textSize="14sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/sb_azul" />
            </LinearLayout>

            <!-- Opción: Unirme a una comunidad (vecino) -->
            <LinearLayout
                android:id="@+id/cardUnirseComunidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card_unirse"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="150dp"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="105dp"
                    android:layout_height="105dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sb_ilustracion_unirse" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="100dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="12dp"
                    android:background="@color/sb_borde" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sb_unirme_titulo"
                        android:textColor="@color/sb_azul_oscuro"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/sb_unirme_desc"
                        android:textColor="@color/sb_texto"
                        android:textSize="14sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/sb_verde" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
