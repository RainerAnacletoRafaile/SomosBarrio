<?xml version="1.0" encoding="utf-8"?>
<!-- Nota: los atributos layout_* (ancho, alto, márgenes) NO funcionan dentro de estilos,
     por eso se escriben directamente en cada layout. -->
<resources>

    <style name="SbTitulo">
        <item name="android:textColor">@color/sb_azul_oscuro</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="SbSubtitulo">
        <item name="android:textColor">@color/sb_texto</item>
        <item name="android:textSize">16sp</item>
        <item name="android:gravity">center</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <!-- Contenedor redondeado de un campo (ícono + EditText) -->
    <style name="SbInputBox">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="SbInputIcon">
        <item name="android:tint">@color/sb_texto</item>
    </style>

    <style name="SbEditText">
        <item name="android:background">@null</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:textColor">@color/sb_texto</item>
        <item name="android:textColorHint">@color/sb_texto_hint</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SbBtnPrimario">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/sb_blanco</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:drawableTint">@color/sb_blanco</item>
        <item name="android:clickable">true</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="SbBtnContorno">
        <item name="android:background">@drawable/bg_btn_outline</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/sb_azul</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:drawableTint">@color/sb_azul</item>
        <item name="android:clickable">true</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Cuadro informativo celeste -->
    <style name="SbInfoBox">
        <item name="android:background">@drawable/bg_info</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:padding">14dp</item>
    </style>

    <style name="SbInfoTexto">
        <item name="android:textColor">@color/sb_azul_oscuro</item>
        <item name="android:textSize">14sp</item>
    </style>

</resources>
